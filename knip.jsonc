{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip's job here is narrow and worth the config: catch a dependency a package
  // declares and never imports, before it becomes something a reader assumes is
  // load-bearing.
  "workspaces": {
    "backend/packages/server": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "backend/packages/persistence-d1": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // `cloudflare:test` is the pool's virtual module, and wrangler is reached
      // through `wrangler.toml` rather than through an import: the suite runs
      // inside workerd, against a D1 binding this package's own config
      // declares.
      "ignoreDependencies": ["cloudflare", "wrangler"],
    },
    "backend/packages/persistence-postgres": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "deploy/backend": {
      // `@sainte-beuve/persistence-d1` is a dependency so that
      // `migrations_dir` in wrangler.toml resolves into the installed package.
      // Nothing here imports it, and that is the point: the schema ships with
      // the adapter rather than being copied into every deployment.
      "ignoreDependencies": ["@sainte-beuve/persistence-d1"],
    },
    "backend/runtimes/cloudflare": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // `cloudflare:test` is a virtual module the Workers pool injects; there is no
      // package behind it to list.
      "ignoreDependencies": ["cloudflare"],
    },
    "backend/runtimes/node": {
      "entry": ["src/main.ts"],
    },
    "backend/runtimes/local": {
      "entry": ["src/main.ts"],
    },
    "frontend/app": {
      "entry": ["app/**/*.{ts,vue}"],
      // `vue` and `vue-tsc` are used by tooling rather than by an import: the SFCs
      // compile against the pinned Vue, and `nuxt typecheck` shells out to vue-tsc.
      "ignoreDependencies": ["vue", "vue-tsc"],
    },
    "deploy/frontend": {
      "ignoreDependencies": ["vue-tsc"],
    },
  },
}
