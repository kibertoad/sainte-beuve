{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip's job here is narrow and worth the config: catch a dependency a package
  // declares and never imports, before it becomes something a reader assumes is
  // load-bearing.
  "workspaces": {
    "backend/packages/server": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "backend/runtimes/cloudflare": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // `cloudflare:test` is a virtual module the Workers pool injects; there is no
      // package behind it to list.
      "ignoreDependencies": ["cloudflare"],
    },
    "backend/runtimes/node": {
      "entry": ["src/main.ts"],
    },
    "backend/runtimes/local": {
      "entry": ["src/main.ts"],
    },
    "frontend/app": {
      "entry": ["app/**/*.{ts,vue}"],
      // `vue` and `vue-tsc` are used by tooling rather than by an import: the SFCs
      // compile against the pinned Vue, and `nuxt typecheck` shells out to vue-tsc.
      "ignoreDependencies": ["vue", "vue-tsc"],
    },
    "deploy/frontend": {
      "ignoreDependencies": ["vue-tsc"],
    },
  },
}
