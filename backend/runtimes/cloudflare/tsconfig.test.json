{
  // The smoke suite lives outside `src/`, so it is not part of the emitted
  // project. Typechecked separately rather than not at all: it carries the
  // declaration of the bindings the suite runs with, and a declaration nobody
  // compiles is one that can go stale without a word.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["test/**/*.ts", "src/**/*.ts"]
}
