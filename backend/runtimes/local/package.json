{
  "name": "@sainte-beuve/local-server",
  "version": "0.1.0",
  "description": "Local-mode runtime facade for sainte-beuve: the Node stack with every optional dependency made optional in practice, so a developer can run the whole product on their own machine against a local cat-factory and no Slack workspace at all.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/sainte-beuve.git",
    "directory": "backend/runtimes/local"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -b tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@sainte-beuve/node-server": "workspace:*",
    "@sainte-beuve/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
