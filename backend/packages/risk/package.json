{
  "name": "@sainte-beuve/risk",
  "version": "0.1.0",
  "description": "Risk assessment for sainte-beuve: what kind of change a pull request is, how complex, risky and far-reaching it reads from its changed files, whether a risk policy lets it through, and whether to approve it unattended. Pure logic over data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/sainte-beuve.git",
    "directory": "backend/packages/risk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@sainte-beuve/contracts": "workspace:*",
    "@sainte-beuve/kernel": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
