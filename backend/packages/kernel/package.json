{
  "name": "@sainte-beuve/kernel",
  "version": "0.1.0",
  "description": "Shared vocabulary, domain errors and PORT interfaces for sainte-beuve. Every adapter (persistence, Slack, GitHub, cat-factory) implements a port declared here; nothing in this package reaches a network or a database.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/sainte-beuve.git",
    "directory": "backend/packages/kernel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sainte-beuve/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
