{
  // The suite lives outside `src/`, so it is not part of the emitted project.
  // Typechecked separately rather than not at all: a test that stopped compiling
  // is the same defect as a source file that did, and this one carries the
  // `cloudflare:test` module augmentation that declares the suite's bindings.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["test/**/*.ts", "src/**/*.ts"]
}
