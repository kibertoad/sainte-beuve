{
  "name": "@sainte-beuve/persistence-memory",
  "version": "0.1.0",
  "description": "In-memory implementations of the sainte-beuve repository ports. What a facade boots with when no database is configured, and the fixture the domain suites run against.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/sainte-beuve.git",
    "directory": "backend/packages/persistence-memory"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@sainte-beuve/contracts": "workspace:*",
    "@sainte-beuve/kernel": "workspace:*"
  },
  "devDependencies": {
    "@sainte-beuve/persistence-conformance": "workspace:*",
    "@types/node": "^26.5.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
