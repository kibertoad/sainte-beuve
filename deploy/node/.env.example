# Copy to `.env`. Every integration value is optional: leave one out and the
# capability it powers reports as off on /health instead of failing a request.
PORT=8788
LOG_LEVEL=info
# Origins the SPA is served from. The Configuration screen needs the SPA's own
# origin here even when the board runs on `*`: the routes that hold a credential
# are excluded from the wildcard, and so are the AI-review routes, whose reads
# spend this deployment's cat-factory key. APP_BASE_URL's origin is folded in
# automatically, so a deployment that sets it need not repeat it here. A
# localhost SPA is named by the wildcard only when this process is itself on
# localhost; against a hosted deployment it goes in the list like any other.
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# How often the reminder clock runs, in ms.
REMINDER_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# The database. Leave DATABASE_URL out and the process runs on an in-memory
# store that a restart empties, which is right for a laptop and wrong for
# anything a team can see; /health reports which one is in force
# (`persistence: "memory"` or `"postgres"`).
#
# The schema is brought up to date at boot from the migrations that ship inside
# @sainte-beuve/persistence-postgres. Set DATABASE_MIGRATE=false in a deployment
# that would rather apply them as a step of its own, against
# POSTGRES_MIGRATIONS_DIR.
#
# Blank here on purpose: a copied file has to start the process, and a URL
# pointing at a database nobody has started yet fails the boot outright (the
# migrations run before the server accepts a request). The local container the
# README brings up answers on:
#   DATABASE_URL=postgres://sainte_beuve:sainte_beuve@localhost:5432/sainte_beuve
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=
DATABASE_MIGRATE=

# cat-factory: the instance AI reviews are delegated to. The base URL and the
# service id are needed together; the API key can be set here or entered on the
# Configuration screen, and a key with no base URL reaches nothing.
#
# The key needs cat-factory's `decide` scope, not `write`: a review PARKS on its
# findings for somebody to curate, and cat-factory refuses to start a run the
# calling key could not then answer.
CAT_FACTORY_BASE_URL=http://localhost:8787
CAT_FACTORY_SERVICE_ID=
CAT_FACTORY_PIPELINE_ID=
CAT_FACTORY_API_KEY=

# ---------------------------------------------------------------------------
# GitHub. Three ways to connect, and they are not alternatives to choose between
# here: whichever are configured are OFFERED on the Configuration screen, and
# the strongest one present is what calls are made with. In order:
#
#   1. the App          the only credential that is not a person's
#   2. a sign-in        minted by a live "Sign in with GitHub", revocable by them
#   3. a stored token   pasted on the Configuration screen
#   4. GITHUB_TOKEN     below, and last, because nobody can see or change it
#                       from the board
# ---------------------------------------------------------------------------

# The GitHub App. The ID signs the JWT and the SLUG addresses the public install
# page: they are different strings for the same App, and both are needed before
# the screen can offer an install. The private key must be PKCS#8; GitHub issues
# PKCS#1, so convert it once:
#   openssl pkcs8 -topk8 -nocrypt -in key.pem -out key.pk8.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# The OAuth client behind "Sign in with GitHub". A GitHub App has its own client
# id and secret, and those are the right ones to use when you have an App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Scopes the sign-in asks for. `read:user` is enough to identify the signer; a
# deployment reaching repositories with THIS credential rather than with an App
# has to ask for `repo` as well.
GITHUB_OAUTH_SCOPE=read:user

# A personal access token, for a deployment that wants no app registration.
GITHUB_TOKEN=
# GitHub Enterprise Server's API base. Leave blank for github.com.
GITHUB_API_BASE_URL=
# The secret inbound deliveries are signed with. Without it every delivery is
# refused, because an unsigned event is a stranger's POST.
GITHUB_WEBHOOK_SECRET=
# The login the bot answers to when it is @-mentioned in a pull-request comment.
# Either form of a GitHub App's login works: it comments as `name[bot]` and is
# mentioned as `@name`.
GITHUB_BOT_LOGIN=
# The labels that drive the board. These are the defaults; name your own.
GITHUB_LABEL_REVIEW=needs-review
GITHUB_LABEL_AI_REVIEW=ai-review
GITHUB_LABEL_SKILL_PREFIX=skill:

# ---------------------------------------------------------------------------
# GitLab. One base URL configures the whole connection: an install serves its
# API and its OAuth endpoints under the same root, unlike GitHub. There is no
# App equivalent, so the precedence here is a sign-in, then a stored token, then
# GITLAB_TOKEN. The webhook intake is GitHub-only for now, so there is no
# GitLab signing secret to set.
# ---------------------------------------------------------------------------
# The install's root. Leave blank for gitlab.com.
GITLAB_BASE_URL=
# A personal or group access token.
GITLAB_TOKEN=
# The OAuth application behind "Sign in with GitLab". Its callback URL is
# `<this deployment>/connect/gitlab/callback`.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Scopes the sign-in asks for. `read_api` is what listing merge requests needs;
# `read_user` alone would identify the signer and then show an empty workspace.
GITLAB_OAUTH_SCOPE=read_api

# ---------------------------------------------------------------------------
# Slack. Two halves that are configured separately and fail separately: the bot
# token posts OUT, and the signing secret is what lets the deployment trust the
# slash command and the message buttons coming back IN.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Who is allowed to call this deployment.
#
# `open` (the default, and what every deployment ran before sessions existed)
# refuses nobody: the workspace renders for whoever this deployment's
# source-control credential acts as. `required` refuses an anonymous call to
# everything under /api/v1 but the sign-in routes, and the workspace then
# renders for whoever is SIGNED IN.
#
# A `required` deployment needs a way in before it has any sessions: an OAuth
# client (GITHUB_OAUTH_CLIENT_ID / GITLAB_OAUTH_CLIENT_ID above, plus
# SETTINGS_ENCRYPTION_KEY, which signs the round trip) for a person, and
# AUTH_API_KEY for a machine. /health reports the mode and the hosts a sign-in
# could use, so a deployment nobody can enter is visible from outside.
#
# Note CORS: a browser only sends the session cookie to an origin the response
# NAMES, and it refuses a `*` answer outright on any request that asked to send
# one — which the SPA's client does on every call. So a hosted SPA has to be an
# origin this deployment named, through CORS_ORIGINS or through APP_BASE_URL. A
# wildcard alone reaches no browser-served SPA at all.
# ---------------------------------------------------------------------------
AUTH_MODE=open
# Presented as `Authorization: Bearer <key>`. Any value will do — there is no
# prefix to get right. Matched before the store, so it still works while the
# database is being restored, and it is what mints the first key on a deployment
# nobody has signed in to. Keys minted on the Configuration screen live in the
# store as digests and are shown once.
AUTH_API_KEY=
# How long a session lasts, in ms. Defaults to 30 days.
AUTH_SESSION_LIFETIME_MS=

# Seals the credentials entered on the SPA's Configuration screen, and signs the
# state carried through a connect round trip. Generate one with
# `openssl rand -base64 32`. Without it the screen refuses to store a token
# rather than writing it in the clear, and the connect buttons refuse to start;
# rotating it makes every stored token unreadable, which the screen reports as
# such.
SETTINGS_ENCRYPTION_KEY=
