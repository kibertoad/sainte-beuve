# Copy to `.env`. Every integration value is optional: leave one out and the
# capability it powers reports as off on /health instead of failing a request.
PORT=8788
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# How often the reminder clock runs, in ms.
REMINDER_INTERVAL_MS=60000

# cat-factory: the instance AI reviews are delegated to. All three are needed
# together; two out of three counts as not configured.
CAT_FACTORY_BASE_URL=http://localhost:8787
CAT_FACTORY_API_KEY=
CAT_FACTORY_SERVICE_ID=
CAT_FACTORY_PIPELINE_ID=

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Seals the credentials entered on the SPA's Configuration screen. Generate one
# with `openssl rand -base64 32`. Without it the screen refuses to store a token
# rather than writing it in the clear; rotating it makes every stored token
# unreadable, which the screen reports as such.
SETTINGS_ENCRYPTION_KEY=
