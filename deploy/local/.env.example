# Local mode needs NOTHING to start. Copy this to `.env` only when you want to
# attach a real integration; each block is independent.

# Point at your own local cat-factory (the default) or at the centralized one.
# The key needs cat-factory's `decide` scope: a review parks on its findings, and
# a `write` key could not answer it, so cat-factory will not start the run.
CAT_FACTORY_BASE_URL=http://localhost:8787
CAT_FACTORY_API_KEY=
CAT_FACTORY_SERVICE_ID=

# GitHub. A personal access token is the shortest path locally; the Configuration
# screen accepts one too, so this only saves a paste. A GitHub App works here as
# well, and is the one worth setting up if you want to watch the bot answer a
# mention: reaching a laptop from GitHub needs a tunnel (`cloudflared tunnel
# --url http://localhost:8788`), and the webhook secret is what makes the
# deliveries it forwards trustworthy.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=

# Sign in with GitHub, locally. The OAuth app's callback URL has to be
# `http://localhost:8788/connect/github/callback`, which GitHub accepts for
# loopback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitLab. One base URL configures the whole connection, because an install
# serves its API and its OAuth endpoints under the same root. Leave it blank for
# gitlab.com. There is no App equivalent: a group access token is a pasted token
# like any other. The sign-in callback is
# `http://localhost:8788/connect/gitlab/callback`.
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Attach a Slack workspace to watch reminders actually arrive. The signing secret
# is only needed for the inbound half (`/review` and the message buttons), which
# also needs a tunnel.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Local mode generates one of these per boot, so the Configuration screen works
# unset, and this blank line counts as unset rather than as an empty key. Set it
# (`openssl rand -base64 32`) only to pin the key across restarts.
SETTINGS_ENCRYPTION_KEY=
