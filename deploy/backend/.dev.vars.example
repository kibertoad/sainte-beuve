# Copy to `.dev.vars` for `wrangler dev`. Every value is optional: leave one out and
# the capability it powers reports as off on /health instead of failing a request.
# The names match the Node service's `.env.example` one for one, because a
# variable that exists on one runtime and not the other is a capability that
# works on one deployment and not the other.
#
# The key needs cat-factory's `decide` scope, not `write`: a review PARKS on its
# findings for somebody to curate, and cat-factory refuses to start a run the
# calling key could not then answer.
CAT_FACTORY_BASE_URL=http://localhost:8787
CAT_FACTORY_SERVICE_ID=
CAT_FACTORY_API_KEY=

# GitHub, in the three shapes a deployment can be connected in. Whichever are
# configured are offered on the Configuration screen, and the strongest present
# is what calls are made with: the App, then a sign-in, then a stored token, then
# GITHUB_TOKEN.
#
# The App private key must be PKCS#8; GitHub issues PKCS#1, so convert it once:
#   openssl pkcs8 -topk8 -nocrypt -in key.pem -out key.pk8.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Either form of a GitHub App's login works: it comments as `name[bot]` and is
# mentioned as `@name`.
GITHUB_BOT_LOGIN=

# GitLab. One base URL configures the whole connection (the API and the OAuth
# endpoints share a root); blank means gitlab.com. No App equivalent exists, so
# the order is a sign-in, then a stored token, then GITLAB_TOKEN.
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Who is allowed to call this deployment.
#
# `open` (the default, and what every deployment ran before sessions existed)
# refuses nobody: the workspace renders for whoever this deployment's
# source-control credential acts as. `required` refuses an anonymous call to
# everything under /api/v1 but the sign-in routes, and the workspace then
# renders for whoever is SIGNED IN.
#
# A `required` deployment needs a way in before it has any sessions: an OAuth
# client (GITHUB_OAUTH_CLIENT_ID / GITLAB_OAUTH_CLIENT_ID above, plus
# SETTINGS_ENCRYPTION_KEY, which signs the round trip) for a person, and
# AUTH_API_KEY for a machine. /health reports the mode and the hosts a sign-in
# could use, so a deployment nobody can enter is visible from outside.
#
# Note CORS: a browser only sends the session cookie to an origin the response
# NAMES, so a hosted SPA has to be listed in CORS_ORIGINS. A wildcard serves
# reads and can never carry a session. Loopback is the one origin the wildcard
# names outright, and only while the deployment is itself on loopback: `wrangler
# dev`, not a deployed Worker.
# ---------------------------------------------------------------------------
AUTH_MODE=open
# Presented as `Authorization: Bearer <key>`. Matched before the store, so it
# still works while the database is being restored. Keys minted on the
# Configuration screen live in the store as digests and are shown once.
AUTH_API_KEY=
# How long a session lasts, in ms. Defaults to 30 days.
AUTH_SESSION_LIFETIME_MS=

# Seals the credentials entered on the SPA's Configuration screen, and signs the
# state carried through a connect round trip. Generate one with
# `openssl rand -base64 32`. Without it the screen refuses to store a token
# rather than writing it in the clear, and the connect buttons refuse to start;
# rotating it makes every stored token unreadable, which the screen reports as
# such.
SETTINGS_ENCRYPTION_KEY=
