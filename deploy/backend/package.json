{
  "name": "@sainte-beuve/deploy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Example Cloudflare Worker deployment of the @sainte-beuve/worker library. Carries the wrangler.toml and config; copy this package to deploy the backend on your own Cloudflare account.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply sainte-beuve --remote",
    "db:migrate:local": "wrangler d1 migrations apply sainte-beuve --local",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sainte-beuve/persistence-d1": "workspace:*",
    "@sainte-beuve/worker": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260815.1",
    "typescript": "7.0.2",
    "wrangler": "4.124.0"
  }
}
